# ─────────────────────────────────────────────────────────────────────────────
# Warehouse OS — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to server/.env and fill in your values, or configure these
# settings directly inside the web UI upon first launch.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Connection
# Format: postgres://username:password@hostname:5432/database_name
DATABASE_URL=postgres://postgres:postgres@localhost:5432/warehouse_os

# JWT Secret for Session Authentication (Generate a random 32+ character string)
JWT_SECRET=replace-with-a-secure-random-jwt-secret-key-32-chars

# Helm WMS Integration (Optional here — can also be set via in-app Settings wizard)
HELM_API_BASE=https://yourcompany.myhelm.app/public-api
HELM_EMAIL=admin@yourcompany.com
HELM_PASSWORD=your-helm-login-password
HELM_2FA_CODE=

# Warehouse Public TV Board Access Key (Optional)
# If set, the public /warehouse TV board requires ?key=YOUR_KEY
WAREHOUSE_KEY=

# Optional Integrations
# Xero OAuth
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5000/api/xero/callback

# Google / Gmail Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/auth/callback
